#pragma kernel CSAdaptiveClassifyGroups
#pragma kernel CSAdaptiveApplyBucketRemap
#pragma kernel CSAdaptiveDiagnostics
#pragma kernel ClearAdaptiveSamplingState
#pragma kernel ClearAdaptiveFrameMetadata
#pragma kernel RecordAdaptiveRetiredPaths
#pragma kernel ClearAdaptiveAllocationMetadata
#pragma kernel ClearAdaptiveGroupState
#pragma kernel ClearAdaptiveScheduler
#include "../Scripts/RayTracingAdaptiveSchedulerShared.hlsl"

[numthreads(4,4,1)]
void ClearAdaptiveSamplingState(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    AdaptiveSamplingState.GetDimensions(width, height);
    if (id.x < width && id.y < height)
    {
        AdaptiveSamplingState[id.xy] = 0.0f;
        AdaptiveSamplingM2[id.xy] = 0.0f;
    }
}

[numthreads(64,1,1)]
void ClearAdaptiveGroupState(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _AdaptiveGroupCount)
    {
        AdaptiveGroupState[id.x] = 0u;
        AdaptiveGroupInfo[id.x] = 0u;
    }
}

[numthreads(64,1,1)]
void ClearAdaptiveScheduler(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _AdaptiveBucketCount)
    {
        AdaptiveRawBucketDemand[id.x] = 0u;
    }
}

groupshared float AdaptiveGroupScore[64];
groupshared float3 AdaptiveGroupAccumulation[64];
groupshared float AdaptiveGroupPathCount[64];
groupshared uint AdaptiveGroupSamples[64];
groupshared uint AdaptiveGroupBootstrap[64];
groupshared uint AdaptiveGroupSeedHistory;

// Map each physical threadgroup to one unique logical group for this scheduler epoch. The bounded
// coprime-stride search keeps the mapping bijective for partial test dimensions too. It changes
// atomic arrival order without changing any image-space group ownership.
uint GreatestCommonDivisor(uint left, uint right)
{
    [loop]
    while (right != 0u)
    {
        uint remainder = left % right;
        left = right;
        right = remainder;
    }
    return left;
}

uint GetAdaptiveGroupPermutationStride(uint groupCount)
{
    uint stride = 1u;
    [unroll]
    for (uint candidate = 3u; candidate <= 31u; candidate += 2u)
    {
        if (stride == 1u && groupCount > 1u && GreatestCommonDivisor(candidate, groupCount) == 1u)
            stride = candidate;
    }
    // A prime group count above the bounded candidates still has a coprime unit stride. This
    // retains correctness; common render sizes select a nontrivial stride above.
    return stride;
}

uint2 GetAdaptiveLogicalGroup(uint2 physicalGroup)
{
    uint groupCount = _AdaptiveGroupWidth * _AdaptiveGroupHeight;
    uint physicalFlat = physicalGroup.x + physicalGroup.y * _AdaptiveGroupWidth;
    uint stride = GetAdaptiveGroupPermutationStride(groupCount);
    uint offset = Hash(_AdaptiveScheduleRotation * 2246822519u) % max(1u, groupCount);
    uint logicalFlat = (physicalFlat * stride + offset) % max(1u, groupCount);
    return uint2(logicalFlat % _AdaptiveGroupWidth, logicalFlat / _AdaptiveGroupWidth);
}

float GetAdaptiveBucketRateFloat(uint bucket)
{
    uint priorityBucketCount = max(1u, _AdaptiveBucketCount - 1u);
    float position = priorityBucketCount <= 1u ? 0.5f : (float)bucket / (float)(priorityBucketCount - 1u);
    float highestRate = min(_AdaptiveHighestBucketSampleRate, (float)_AdaptiveMaxPathsPerPixel);
    return exp2(lerp(-log2(highestRate), log2(highestRate), position));
}

// Assign a source-band group to a target tier based on the overlap of their population intervals.
// A hashed position breaks ties inside a quantized source band without changing the score ordering
// between bands. This is a bounded 15-bucket calculation, not an image-sized sort or scan.
uint GetAdaptiveTargetBucket(uint sourceBucket, uint flatGroup)
{
    uint priorityBucketCount = _AdaptiveBucketCount > 1u ? min(16u, _AdaptiveBucketCount - 1u) : 1u;
    uint safeSourceBucket = min(sourceBucket, priorityBucketCount - 1u);
    uint totalPixels = 0u;
    uint sourceBegin = 0u;
    uint sourceDemand = 0u;
    float rateSum = 0.0f;
    float inverseRateSum = 0.0f;
    [unroll] for (uint sourceBucketIndex = 0u; sourceBucketIndex < 16u; sourceBucketIndex++)
    {
        if (sourceBucketIndex < priorityBucketCount)
        {
            uint demand = AdaptiveRawBucketDemand[sourceBucketIndex];
            totalPixels += demand;
            if (sourceBucketIndex < safeSourceBucket) sourceBegin += demand;
            if (sourceBucketIndex == safeSourceBucket) sourceDemand = demand;
            float rate = GetAdaptiveBucketRateFloat(sourceBucketIndex);
            rateSum += rate;
            inverseRateSum += rcp(rate);
        }
    }

    uint targetBucket = safeSourceBucket;
    if (sourceDemand != 0u && totalPixels != 0u)
    {
        // Pure inverse-rate populations under-spend the frame for a geometric rate curve. Add the
        // minimum uniform component required for the tier-weighted expected rate to equal one.
        float uniformWeight = max(0.0f, (inverseRateSum - priorityBucketCount)
            / max(0.000001f, rateSum - priorityBucketCount));
        float random = (float)Hash(flatGroup ^ (_AdaptiveScheduleRotation * 747796405u)) / 4294967296.0f;
        float sourcePosition = sourceBegin + random * sourceDemand;
        float weightSum = inverseRateSum + uniformWeight * priorityBucketCount;
        float targetEnd = totalPixels * (rcp(GetAdaptiveBucketRateFloat(0u)) + uniformWeight)
            / max(weightSum, 0.000001f);
        bool targetFound = false;
        targetBucket = priorityBucketCount - 1u;
        [unroll] for (uint targetBucketIndex = 0u; targetBucketIndex < 16u; targetBucketIndex++)
        {
            if (!targetFound && targetBucketIndex < priorityBucketCount)
            {
                if (targetBucketIndex == priorityBucketCount - 1u || sourcePosition < targetEnd)
                {
                    targetBucket = targetBucketIndex;
                    targetFound = true;
                }
                else
                {
                    targetEnd += totalPixels
                        * (rcp(GetAdaptiveBucketRateFloat(targetBucketIndex + 1u)) + uniformWeight)
                        / max(weightSum, 0.000001f);
                }
            }
        }
    }
    return targetBucket;
}

// Classify spatial groups into logarithmic source bands. The next stage divides each source band
// across overlapping inverse-rate target tiers, so a concentrated score band cannot collapse into
// one output bucket.


[numthreads(8,8,1)]
void CSAdaptiveClassifyGroups(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex,
    uint3 groupId : SV_GroupID)
{
    uint width, height;
    AccumulationResult.GetDimensions(width, height);
    uint2 logicalGroup = GetAdaptiveLogicalGroup(groupId.xy);
    uint2 localPixel = uint2(groupIndex & 7u, groupIndex >> 3u);
    uint2 pixel = logicalGroup * 8u + localPixel;
    bool valid = pixel.x < width && pixel.y < height;
    float score = 0.0f;
    bool bootstrap = false;
    if (valid)
    {
        float count = AdaptiveSamplingState[pixel].x;
        float bootstrapPriority = AdaptiveBootstrapPriority[pixel].x;
        float3 m2 = max(0.0f, AdaptiveSamplingM2[pixel].rgb);
        score = count > 1.0f ? sqrt(max(0.0f, (m2.x + m2.y + m2.z) / (count * (count - 1.0f)))) : 1.0f;
        bootstrap = count < (float)max(1, _AdaptiveSamplingMinSamples);
        // A signed exponent controls the error objective without allowing near-black pixels to
        // dominate: negative values weight relative error, positive values weight bright areas.
        float luminance = dot(max(0.0f, AccumulationResult[pixel].rgb), float3(0.2126f, 0.7152f, 0.0722f));
        float luminanceWeight = pow(max(0.25f, luminance), _AdaptiveLuminanceErrorWeight);
        score *= luminanceWeight;
        if (_UseAdaptiveBootstrapPriority != 0 && !bootstrap) score = max(score, bootstrapPriority);
        score = isfinite(score) ? score : 0.0f;
        AdaptiveGroupAccumulation[groupIndex] = all(isfinite(AccumulationResult[pixel].rgb))
            ? AccumulationResult[pixel].rgb : 0.0f;
        AdaptiveGroupPathCount[groupIndex] = isfinite(count) ? max(0.0f, count) : 0.0f;
    }
    else
    {
        AdaptiveGroupAccumulation[groupIndex] = 0.0f;
        AdaptiveGroupPathCount[groupIndex] = 0.0f;
    }
    AdaptiveGroupScore[groupIndex] = score;
    AdaptiveGroupSamples[groupIndex] = valid ? 1u : 0u;
    AdaptiveGroupBootstrap[groupIndex] = bootstrap ? 1u : 0u;
    GroupMemoryBarrierWithGroupSync();

    if (groupIndex != 0u) return;

    uint validPixels = 0u;
    float scoreSum = 0.0f;
    float3 accumulationSum = 0.0f;
    float pathCountSum = 0.0f;
    bool groupBootstrap = false;
    [unroll] for (uint reductionLane = 0u; reductionLane < 64u; reductionLane++)
    {
        validPixels += AdaptiveGroupSamples[reductionLane];
        scoreSum += AdaptiveGroupScore[reductionLane];
        accumulationSum += AdaptiveGroupAccumulation[reductionLane];
        pathCountSum += AdaptiveGroupPathCount[reductionLane];
        groupBootstrap = groupBootstrap || AdaptiveGroupBootstrap[reductionLane] != 0u;
    }

    uint flatGroup = logicalGroup.x + logicalGroup.y * _AdaptiveGroupWidth;
    uint bucket = _AdaptiveBucketCount - 1u;

    if (!groupBootstrap)
    {
        float meanScore = scoreSum / max(1u, validPixels);
        // Spatial disagreement is a short-lived priority prior, not a noise estimate. It gives
        // early attention to uncertain groups but decays even when persistent scene contrast remains.
        if (_AdaptiveSpatialDisagreementPriority > 0.0f)
        {
            float3 meanAccumulation = accumulationSum / max(1u, validPixels);
            float disagreementSquaredSum = 0.0f;
            [unroll] for (uint reductionLane = 0u; reductionLane < 64u; reductionLane++)
            {
                if (AdaptiveGroupSamples[reductionLane] == 0u) continue;
                float3 difference = AdaptiveGroupAccumulation[reductionLane] - meanAccumulation;
                disagreementSquaredSum += dot(difference, difference);
            }
            float spatialDisagreement = sqrt(max(0.0f,
                disagreementSquaredSum / (3.0f * max(1u, validPixels))));
            float meanLuminance = dot(max(0.0f, meanAccumulation), float3(0.2126f, 0.7152f, 0.0722f));
            float luminanceWeight = pow(max(0.25f, meanLuminance), _AdaptiveLuminanceErrorWeight);
            float normalizedDisagreement = spatialDisagreement * luminanceWeight;
            float averageSpp = pathCountSum / max(1u, validPixels);
            float decay = min(1.0f, (float)max(1, _AdaptiveSamplingMinSamples) / max(1.0f, averageSpp));
            float spatialBonus = _AdaptiveSpatialDisagreementPriority * normalizedDisagreement * decay;
            meanScore += isfinite(spatialBonus) ? spatialBonus : 0.0f;
        }
        meanScore = isfinite(meanScore) ? meanScore : 0.0f;
        uint priorityBucketCount = max(1u, _AdaptiveBucketCount - 1u);
        bucket = min(priorityBucketCount - 1u,
            (uint)floor(log2(1.0f + meanScore * 4096.0f) * priorityBucketCount / 15.0f));
    }

    AdaptiveGroupBucket[flatGroup] = bucket;
    // ExtraDemand is the epoch-eligibility marker consumed by remap. Keep it nonzero for both
    // bootstrap and established groups; GroupState carries the separate bootstrap classification.
    AdaptiveGroupState[flatGroup] = uint4(groupBootstrap ? 1u : 2u, bucket, 0u, 0u);
    AdaptiveGroupExtraDemand[flatGroup] = validPixels;
    InterlockedAdd(AdaptiveRawBucketDemand[bucket], validPixels);
}

[numthreads(8,8,1)]
void CSAdaptiveApplyBucketRemap(uint3 id : SV_DispatchThreadID, uint groupIndex : SV_GroupIndex,
    uint3 groupId : SV_GroupID)
{
    if (groupIndex != 0u) return;
    uint width, height;
    Result.GetDimensions(width, height);
    uint2 logicalGroup = GetAdaptiveLogicalGroup(groupId.xy);
    uint flatGroup = logicalGroup.x + logicalGroup.y * _AdaptiveGroupWidth;
    uint sourceBucket = AdaptiveGroupState[flatGroup].y;
    bool bootstrap = AdaptiveGroupState[flatGroup].x == 1u;
    uint bucket = bootstrap ? _AdaptiveBucketCount - 1u : GetAdaptiveTargetBucket(sourceBucket, flatGroup);
    uint validPixels = min(8u, width - logicalGroup.x * 8u) * min(8u, height - logicalGroup.y * 8u);
    uint samples = (uint)max(1, _NumberOfPasses);
    if (bootstrap)
    {
        // Bootstrap admission must rotate every rendered frame, not only when cached scores are
        // reclassified. Otherwise schedule reuse starves cohorts for the entire reuse interval.
        uint bootstrapBatch = (flatGroup + _AdaptiveScheduleRotation) % max(1u, _AdaptiveBootstrapGroupDivisor);
        bool needsFirstFineSample = AdaptiveSamplingState[logicalGroup * 8u].x == 0.0f;
        if (!needsFirstFineSample && _AdaptiveBootstrapGroupDivisor > 1u && bootstrapBatch != 0u)
        {
            AdaptiveGroupInfo[flatGroup] = 0u;
            AdaptiveGroupExtraDemand[flatGroup] = 0u;
            return;
        }
    }
    else
    {
        float rate = GetAdaptiveBucketRateFloat(bucket);
        uint wholePaths = (uint)floor(rate);
        float fraction = frac(rate);
        // Use a separate sequence from tier selection so fractional-rate admission remains
        // unbiased after lower-rate tiers consume the lower part of the selection interval.
        float random = (float)Hash(flatGroup ^ (_AdaptiveScheduleRotation * 2891336453u)) / 4294967296.0f;
        samples = min(_AdaptiveMaxPathsPerPixel, wholePaths + (random < fraction ? 1u : 0u));
    }
    uint paths = validPixels * samples;
    AdaptiveGroupBucket[flatGroup] = bucket;
    AdaptiveGroupExtraDemand[flatGroup] = paths;
    InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataBucketPopulationStart + bucket], validPixels);
    if (paths != 0u)
    {
        InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataAssignedPaths], paths);
        InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataFullResolutionPaths], paths);
        InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataWorkItemCount], validPixels);
        InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataBucketAdmittedPathsStart + bucket], paths);
        InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataBucketBudgetStart + bucket], paths);
    }
    AdaptiveGroupInfo[flatGroup] = uint4(0u, 0u, validPixels,
        validPixels != 0u ? paths / validPixels : 0u);
}

[numthreads(1,1,1)]
void ClearAdaptiveFrameMetadata(uint3 id : SV_DispatchThreadID)
{
    // Group allocations persist between reclassification passes. Only this counter is per-dispatch,
    // so capture diagnostics continue to validate one frame of retired work.
    AdaptiveWorkListMetadata[AdaptiveMetadataRetiredPaths] = 0u;
    uint fullResolutionPaths = AdaptiveWorkListMetadata[AdaptiveMetadataFullResolutionPaths];
    AdaptiveWorkListMetadata[AdaptiveMetadataRequestedPaths] = fullResolutionPaths;
    AdaptiveWorkListMetadata[AdaptiveMetadataGuidancePaths] = 0u;
}

[numthreads(1,1,1)]
void RecordAdaptiveRetiredPaths(uint3 id : SV_DispatchThreadID)
{
    // The fused trace reads metadata as an SRV to stay within Metal's eight-UAV limit.
    // Capture accounting can therefore publish the equivalent completed compact-path total here.
    AdaptiveWorkListMetadata[AdaptiveMetadataRetiredPaths] = AdaptiveWorkListMetadata[AdaptiveMetadataAssignedPaths];
}

[numthreads(1,1,1)]
void ClearAdaptiveAllocationMetadata(uint3 id : SV_DispatchThreadID)
{
    uint index = id.x;
    if (index < 64u)
    {
        AdaptiveWorkListMetadata[index] = index == AdaptiveMetadataPathCountMin ? 0xffffffffu : 0u;
    }
}


[numthreads(4,4,1)]
void CSAdaptiveDiagnostics(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    Result.GetDimensions(width, height);
    uint2 pixel = id.xy;
    if (pixel.x >= width || pixel.y >= height) return;

    uint flatPixel = pixel.x + pixel.y * width;
    float4 state = AdaptiveSamplingState[pixel];
    float3 m2 = max(0.0f, AdaptiveSamplingM2[pixel].rgb);
    uint pathCount = (uint)max(0.0f, state.x);
    float uncertainty = state.x > 1.0f
        ? sqrt(max(0.0f, (m2.x + m2.y + m2.z) / (state.x * (state.x - 1.0f)))) : 0.0f;
    uint uncertaintyFixed = (uint)min(4294.0f, uncertainty * 1000000.0f);
    InterlockedMin(AdaptiveWorkListMetadata[AdaptiveMetadataPathCountMin], pathCount);
    InterlockedMax(AdaptiveWorkListMetadata[AdaptiveMetadataPathCountMax], pathCount);
    InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataPathCountSum], pathCount);
    InterlockedAdd(AdaptiveWorkListMetadata[AdaptiveMetadataUncertaintySum], uncertaintyFixed);
    InterlockedMax(AdaptiveWorkListMetadata[AdaptiveMetadataUncertaintyMax], uncertaintyFixed);
}
