#pragma kernel CSRegressionProbe
#define WATER_ENABLED 1
#include "../Scripts/RayTracingShared.hlsl"

[numthreads(1,1,1)]
void CSRegressionProbe(uint3 id : SV_DispatchThreadID)
{
    float3 normal = float3(0.0f, 1.0f, 0.0f);
    float3 incident45 = normalize(float3(1.0f, -1.0f, 0.0f));
    float3 reflected45 = reflect(incident45, normal);

    float3 refracted45;
    bool didRefract45 = RefractSnell(incident45, 1.0f, 1.5f, normal, refracted45);

    float3 totalInternalDirection = normalize(float3(0.8660254f, 0.5f, 0.0f));
    float3 ignoredDirection;
    bool didRefractTotalInternal = RefractSnell(totalInternalDirection, 1.5f, 1.0f, -normal, ignoredDirection);

    float r0 = (1.0f - 1.5f) / (1.0f + 1.5f);
    r0 *= r0;
    float fresnel45 = r0 + (1.0f - r0) * pow(1.0f - saturate(abs(dot(-incident45, normal))), 5.0f);
    float3 absorption = GetAbsorptionTransmittance(float3(0.25f, 0.5f, 0.75f), 0.6f, 2.0f);

    RegressionResults[0] = float4(reflected45, 1.0f);
    RegressionResults[1] = float4(refracted45, didRefract45 ? 1.0f : 0.0f);
    RegressionResults[2] = float4(ignoredDirection, didRefractTotalInternal ? 1.0f : 0.0f);
    RegressionResults[3] = float4(fresnel45, r0, 0.0f, 1.0f);
    RegressionResults[4] = float4(absorption, 1.0f);

    RayHit waterHit = CreateRayHit();
    waterHit.materialType = MaterialWater;
    waterHit.meshIndex = 0;
    waterHit.refraction = 2.0f;
    waterHit.opacity = 0.18f;
    waterHit.color = float3(0.17f, 0.45f, 0.52f);
    MediumIdentity air = CreateAirMedium();
    MediumIdentity water = CreateHitMedium(waterHit);

    RayHit glassHit = CreateRayHit();
    glassHit.materialType = MaterialGlass;
    glassHit.obj_radius = 1.0f;
    glassHit.objectIndex = 7;
    glassHit.refraction = 1.5f;
    glassHit.opacity = 0.6f;
    glassHit.transmission = 1.0f;
    glassHit.color = float3(0.8f, 0.9f, 1.0f);
    glassHit.normal = normal;
    glassHit.geometricNormal = normal;
    MediumIdentity glass = CreateHitMedium(glassHit);

    RegressionResults[5] = float4(GetMediumTransitionIndices(air, air, waterHit, true), water.type, water.objectIndex);
    RegressionResults[6] = float4(GetMediumTransitionIndices(water, air, glassHit, true), glass.type, glass.objectIndex);
    RegressionResults[7] = float4(GetMediumTransitionIndices(glass, water, glassHit, false), IsSameMedium(glass, CreateHitMedium(glassHit)) ? 1.0f : 0.0f, 1.0f);

    MediumStack nestedStack = CreateMediumStack(float3(0.0f, 2.0f, 0.0f));
    ApplyMediumTransition(nestedStack, waterHit, MediumTransitionEnter);
    ApplyMediumTransition(nestedStack, glassHit, MediumTransitionEnter);
    RegressionResults[8] = float4(GetCurrentMedium(nestedStack).refractionIndex, GetParentMedium(nestedStack).refractionIndex, nestedStack.count, nestedStack.status);

    ApplyMediumTransition(nestedStack, glassHit, MediumTransitionExit);
    RegressionResults[9] = float4(GetCurrentMedium(nestedStack).refractionIndex, GetParentMedium(nestedStack).refractionIndex, nestedStack.count, nestedStack.status);
    ApplyMediumTransition(nestedStack, waterHit, MediumTransitionExit);
    RegressionResults[10] = float4(GetCurrentMedium(nestedStack).refractionIndex, GetCurrentMedium(nestedStack).type, nestedStack.count, nestedStack.status);

    MediumStack mismatchStack = CreateMediumStack(float3(0.0f, 2.0f, 0.0f));
    ApplyMediumTransition(mismatchStack, waterHit, MediumTransitionEnter);
    ApplyMediumTransition(mismatchStack, glassHit, MediumTransitionExit);
    RegressionResults[11] = float4(GetCurrentMedium(mismatchStack).type, mismatchStack.count, mismatchStack.status, IsSameMedium(GetCurrentMedium(mismatchStack), water) ? 1.0f : 0.0f);

    MediumStack overflowStack = CreateMediumStack(float3(0.0f, 2.0f, 0.0f));
    int stackEntry;
    [unroll]
    for (stackEntry = 0; stackEntry < MediumStackCapacity; stackEntry++)
    {
        PushMedium(overflowStack, glass);
    }
    RegressionResults[12] = float4(overflowStack.count, overflowStack.status, GetCurrentMedium(overflowStack).type, GetParentMedium(overflowStack).type);

    MediumStack underwaterStack = CreateMediumStack(float3(0.0f, _WaterCenter.y - 1.0f, 0.0f));
    RegressionResults[13] = float4(GetCurrentMedium(underwaterStack).type, GetCurrentMedium(underwaterStack).refractionIndex, underwaterStack.count, underwaterStack.status);

    float3 waterOrigin = float3(_WaterCenter.x, _WaterCenter.y - 1.0f, _WaterCenter.z);
    float waterSideDistance = GetWaterDistanceAlongRay(CreateRay(waterOrigin, float3(1.0f, 0.0f, 0.0f)), RayMaxDistance);
    float waterSurfaceDistance = GetWaterDistanceAlongRay(CreateRay(waterOrigin, float3(0.0f, 1.0f, 0.0f)), RayMaxDistance);
    float waterClippedDistance = GetWaterDistanceAlongRay(CreateRay(waterOrigin, float3(1.0f, 0.0f, 0.0f)), 2.0f);
    RegressionResults[14] = float4(waterSideDistance, waterSurfaceDistance, waterClippedDistance, GetMediumSegmentDistance(CreateRay(waterOrigin, float3(1.0f, 0.0f, 0.0f)), RayMaxDistance, GetCurrentMedium(underwaterStack)));

    float waterBottomDistance = GetWaterDistanceAlongRay(CreateRay(waterOrigin, float3(0.0f, -1.0f, 0.0f)), RayMaxDistance);
    RayHit waterSideHit = CreateRayHit();
    IntersectWater(CreateRay(float3(_WaterCenter.x - 6.0f, _WaterCenter.y - 1.0f, _WaterCenter.z), float3(1.0f, 0.0f, 0.0f)), waterSideHit);
    RegressionResults[18] = float4(waterBottomDistance, waterSideHit.distance, waterSideHit.materialType, 1.0f);
    RegressionResults[19] = float4(waterSideHit.normal, 1.0f);

    float3 glassSegment = GetMediumSegmentTransmittance(glass, 2.0f);
    float3 waterSegment = GetMediumSegmentTransmittance(water, 2.0f);
    RegressionResults[15] = float4(glassSegment, 1.0f);
    RegressionResults[16] = float4(waterSegment, 1.0f);
    RegressionResults[17] = float4(GetMediumSegmentTransmittance(air, 1000.0f), GetMediumSegmentDistance(CreateRay(float3(0.0f, 2.0f, 0.0f), float3(1.0f, 0.0f, 0.0f)), RayMaxDistance, air));

    MediumStack waterStack = CreateMediumStack(float3(0.0f, 2.0f, 0.0f));
    ApplyMediumTransition(waterStack, waterHit, MediumTransitionEnter);
    bool enteringNestedGlass;
    float2 nestedEntryIndices = GetBoundaryTransitionIndices(waterStack, glassHit, enteringNestedGlass);
    float3 nestedEntryDirection;
    bool didRefractNestedEntry = RefractSnell(incident45, nestedEntryIndices.x, nestedEntryIndices.y, normal, nestedEntryDirection);
    RegressionResults[20] = float4(nestedEntryIndices, enteringNestedGlass ? 1.0f : 0.0f, didRefractNestedEntry ? 1.0f : 0.0f);
    RegressionResults[21] = float4(nestedEntryDirection, GetFresnelReflectance(CreateRay(float3(0.0f, 0.0f, 0.0f), incident45), glassHit, nestedEntryIndices.x, nestedEntryIndices.y));

    MediumStack glassInWaterStack = waterStack;
    PushMedium(glassInWaterStack, glass);
    bool enteringNestedExit;
    float2 nestedExitIndices = GetBoundaryTransitionIndices(glassInWaterStack, glassHit, enteringNestedExit);
    float3 nestedExitDirection;
    bool didRefractNestedExit = RefractSnell(normalize(float3(0.8660254f, 0.5f, 0.0f)), nestedExitIndices.x, nestedExitIndices.y, -normal, nestedExitDirection);
    RegressionResults[22] = float4(nestedExitIndices, enteringNestedExit ? 1.0f : 0.0f, didRefractNestedExit ? 1.0f : 0.0f);
    RegressionResults[23] = float4(nestedExitDirection, glassInWaterStack.count);

    RayHit overlappingGlassHit = glassHit;
    overlappingGlassHit.objectIndex = 8;
    overlappingGlassHit.refraction = 1.0f;
    MediumStack overlappingStack = CreateMediumStack(float3(0.0f, 2.0f, 0.0f));
    PushMedium(overlappingStack, glass);
    PushMedium(overlappingStack, CreateHitMedium(overlappingGlassHit));
    bool enteringOverlappingExit;
    float2 overlappingExitIndices = GetBoundaryTransitionIndices(overlappingStack, glassHit, enteringOverlappingExit);
    ApplyMediumTransition(overlappingStack, glassHit, MediumTransitionExit);
    RegressionResults[24] = float4(overlappingExitIndices, enteringOverlappingExit ? 1.0f : 0.0f, overlappingStack.status);
    RegressionResults[25] = float4(GetCurrentMedium(overlappingStack).objectIndex, GetCurrentMedium(overlappingStack).refractionIndex, overlappingStack.count, MediumStackContains(overlappingStack, glass) ? 1.0f : 0.0f);

    RayHit diffuseBrdfHit = CreateRayHit();
    diffuseBrdfHit.normal = normal;
    diffuseBrdfHit.color = float3(0.8f, 0.4f, 0.2f);
    diffuseBrdfHit.smoothness = 0.5f;
    diffuseBrdfHit.opacity = 1.0f;
    diffuseBrdfHit.materialType = MaterialDiffuse;
    Ray normalIncidenceRay = CreateRay(float3(0.0f, 0.0f, 0.0f), float3(0.0f, -1.0f, 0.0f));
    float diffusePdf;
    float3 diffuseBrdf = EvaluateMaterialBrdf(normalIncidenceRay, diffuseBrdfHit, normal, diffusePdf);
    RegressionResults[26] = float4(diffuseBrdf, diffusePdf);

    RayHit metalBrdfHit = diffuseBrdfHit;
    metalBrdfHit.materialType = MaterialMetal;
    metalBrdfHit.metallic = 1.0f;
    float metalPdf;
    float3 metalBrdf = EvaluateMaterialBrdf(normalIncidenceRay, metalBrdfHit, normal, metalPdf);
    RegressionResults[27] = float4(metalBrdf, metalPdf);

    uint brdfRngState = 12345u;
    BrdfSample brdfSample = SampleMaterialBrdf(normalIncidenceRay, diffuseBrdfHit, brdfRngState);
    RegressionResults[28] = float4(brdfSample.direction, brdfSample.pdf);
    RegressionResults[29] = float4(brdfSample.weight, dot(brdfSample.direction, normal));

    MeshTriangle smoothTriangle;
    smoothTriangle.vertex0 = float3(-1.0f, -1.0f, 0.0f);
    smoothTriangle.vertex1 = float3(1.0f, -1.0f, 0.0f);
    smoothTriangle.vertex2 = float3(0.0f, 1.0f, 0.0f);
    smoothTriangle.normal = float3(0.0f, 0.0f, 1.0f);
    smoothTriangle.normal0 = normalize(float3(-1.0f, 0.0f, 1.0f));
    smoothTriangle.normal1 = normalize(float3(1.0f, 0.0f, 1.0f));
    smoothTriangle.normal2 = normalize(float3(0.0f, 1.0f, 1.0f));
    smoothTriangle.tangent0 = 0.0f;
    smoothTriangle.tangent1 = 0.0f;
    smoothTriangle.tangent2 = 0.0f;
    smoothTriangle.color = 1.0f;
    smoothTriangle.smoothness = 0.0f;
    smoothTriangle.metallic = 0.0f;
    smoothTriangle.uv0 = 0.0f;
    smoothTriangle.uv1 = 0.0f;
    smoothTriangle.uv2 = 0.0f;
    smoothTriangle.opacity = 1.0f;
    smoothTriangle.emission = 0.0f;
    smoothTriangle.refraction = 1.0f;
    smoothTriangle.materialType = MaterialDiffuse;
    smoothTriangle.meshIndex = 0;
    smoothTriangle.textureIndex = -1;
    smoothTriangle.metallicRoughnessTextureIndex = -1;
    smoothTriangle.normalTextureIndex = -1;
    smoothTriangle.parallaxTextureIndex = -1;
    smoothTriangle.parallaxStrength = 0.0f;
    smoothTriangle.minimumParallaxStrength = 0.0f;
    smoothTriangle.interpolateNormals = 1;
    smoothTriangle.lightIndex = -1;
    RayHit smoothHit = CreateRayHit();
    smoothHit = IntersectTriangle(CreateRay(float3(0.0f, 0.0f, 1.0f), float3(0.0f, 0.0f, -1.0f)), smoothHit, smoothTriangle, 0);
    RegressionResults[30] = float4(smoothHit.normal, dot(smoothHit.geometricNormal, float3(0.0f, 0.0f, 1.0f)));
    RegressionResults[34] = float4(GetCausticOpticalNormal(smoothHit), 1.0f);
    smoothHit.materialType = MaterialGlass;
    smoothHit.opacity = 0.0f;
    smoothHit.refraction = 1.5f;
    float3 smoothRefractionDirection;
    bool didSmoothRefraction = RefractSnell(float3(0.0f, 0.0f, -1.0f), 1.0f, smoothHit.refraction, smoothHit.normal, smoothRefractionDirection);
    RegressionResults[35] = float4(smoothRefractionDirection, didSmoothRefraction
        ? GetFresnelReflectance(CreateRay(float3(0.0f, 0.0f, 1.0f), float3(0.0f, 0.0f, -1.0f)), smoothHit, 1.0f, smoothHit.refraction)
        : -1.0f);

    uint smoothGlassRngState = 9182u;
    uint roughGlassRngState = 9182u;
    float3 smoothGlassNormal = SampleDielectricBoundaryNormal(normal, normal, incident45, 1.0f, 1.0f, 1.5f, smoothGlassRngState);
    float3 roughGlassNormal = SampleDielectricBoundaryNormal(normal, normal, incident45, 0.0f, 1.0f, 1.5f, roughGlassRngState);
    float3 smoothGlassDirection;
    float3 roughGlassDirection;
    bool smoothGlassTransmitted = RefractSnell(incident45, 1.0f, 1.5f, smoothGlassNormal, smoothGlassDirection);
    bool roughGlassTransmitted = RefractSnell(incident45, 1.0f, 1.5f, roughGlassNormal, roughGlassDirection);
    RegressionResults[36] = float4(smoothGlassNormal, smoothGlassTransmitted ? 1.0f : 0.0f);
    RegressionResults[37] = float4(roughGlassNormal, roughGlassTransmitted ? length(roughGlassDirection - smoothGlassDirection) : -1.0f);

    MeshTriangle smallTriangle = smoothTriangle;
    smallTriangle.vertex0 = float3(-0.00005f, -0.00005f, 0.0f);
    smallTriangle.vertex1 = float3(0.00005f, -0.00005f, 0.0f);
    smallTriangle.vertex2 = float3(0.0f, 0.00005f, 0.0f);
    float smallTriangleDistance;
    float3 smallTriangleNormal;
    float2 smallTriangleBarycentric;
    bool hitSmallTriangle = IntersectTriangleRaw(
        CreateRay(float3(0.0f, 0.0f, 1.0f), float3(0.0f, 0.0f, -1.0f)),
        smallTriangle,
        smallTriangleDistance,
        smallTriangleNormal,
        smallTriangleBarycentric);
    RegressionResults[38] = float4(smallTriangleDistance, smallTriangleBarycentric, hitSmallTriangle ? 1.0f : 0.0f);

    Light triangleLight;
    triangleLight.position = float3(-1.0f, 2.0f, -1.0f);
    triangleLight.emission = 1.0f;
    triangleLight.u = float3(2.0f, 0.0f, 0.0f);
    triangleLight.radius = 0.0f;
    triangleLight.v = float3(0.0f, 0.0f, 2.0f);
    triangleLight.area = 2.0f;
    triangleLight.normal = float3(0.0f, -1.0f, 0.0f);
    triangleLight.type = LightTypeTriangle;
    RegressionResults[31] = float4(PowerHeuristic(0.25f, 0.5f), PowerHeuristic(0.5f, 0.25f), PowerHeuristic(1.0f, 1.0f), 1.0f);
    RegressionResults[32] = float4(GetLightShapePdf(triangleLight, float3(0.0f, 0.0f, 0.0f), float3(0.0f, 2.0f, 0.0f)), GetSurfaceF0(waterHit, waterHit.color));
    RegressionResults[33] = float4(ClampFirefly(float3(4.0f, 2.0f, 1.0f)), 1.0f);
    RayHit opaqueGlassHit = glassHit;
    opaqueGlassHit.opacity = 1.0f;
    opaqueGlassHit.color = float3(0.1f, 0.4f, 0.9f);
    RegressionResults[39] = float4(GetSurfaceF0(glassHit, glassHit.color), GetSurfaceF0(opaqueGlassHit, opaqueGlassHit.color).x);
    opaqueGlassHit.specular = 0.2f;
    RegressionResults[40] = float4(
        GetGlassReflectionProbability(0.04f, opaqueGlassHit),
        GetSurfaceF0(opaqueGlassHit, opaqueGlassHit.color).x,
        opaqueGlassHit.transmission,
        1.0f);

    Sphere normalProbeSphere;
    normalProbeSphere.position = float3(0.0f, 0.0f, 0.0f);
    normalProbeSphere.color = 1.0f;
    normalProbeSphere.emission = 0.0f;
    normalProbeSphere.radius = 1.0f;
    normalProbeSphere.smoothness = 1.0f;
    normalProbeSphere.opacity = 0.0f;
    normalProbeSphere.specular = 0.0f;
    normalProbeSphere.transmission = 1.0f;
    normalProbeSphere.refraction = 1.5f;
    normalProbeSphere.materialType = MaterialGlass;
    normalProbeSphere.textureIndex = -1;
    normalProbeSphere.normalTextureIndex = -1;
    normalProbeSphere.parallaxTextureIndex = -1;
    normalProbeSphere.parallaxStrength = 0.0f;
    normalProbeSphere.minimumParallaxStrength = 0.0f;
    RayHit insideSphereHit = CreateRayHit();
    IntersectSphere(CreateRay(float3(0.0f, 0.0f, 0.0f), normal), insideSphereHit, normalProbeSphere, 0);
    RegressionResults[41] = float4(insideSphereHit.normal, dot(insideSphereHit.geometricNormal, normal));
}
